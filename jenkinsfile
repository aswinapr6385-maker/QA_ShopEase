pipeline {
    agent any

    environment {
        // Safe credential injection from Jenkins Credential Store
        JIRA_TOKEN        = credentials('jira-api-token')
        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
        JIRA_ENABLED      = 'true'
        SLACK_ENABLED     = 'true'
    }

    stages {
        stage('Run Playwright Tests') {
            steps {
                sh '''
                    mkdir -p logs reports
                    # Execute Playwright tests and stream logs to build.log
                    mvn clean test -DtestFailureIgnore=true | tee logs/build.log
                '''
            }
        }
    }

    post {
        always {
            script {
                def logContent = readFile('logs/build.log')
                // Check if any test failure or surefire error occurred
                if (logContent.contains("FAILURE!") || logContent.contains("BUILD FAILURE")) {
                    echo "🚨 Playwright test failures detected. Triggering Bug Analyzer..."
                    
                    // Run the analyzer JAR
                    sh '''
                        java -jar ci-tools/bug-analyzer.jar \
                             --log logs/build.log \
                             --output reports
                    '''
                }
            }

            // Publish HTML RCA Dashboard in Jenkins UI
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports',
                reportFiles: 'latest-analysis.html',
                reportName: 'Bug Analyzer RCA Report'
            ])

            // Archive the structured JSON for metrics/dashboards
            archiveArtifacts artifacts: 'reports/latest-analysis.json, logs/**', allowEmptyArchive: true
        }
    }
}