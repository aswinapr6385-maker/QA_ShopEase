pipeline {
    agent any

    stages {
        stage('Run Tests') {
            steps {
                sh '''
                    mkdir -p logs reports
                    # The test runs, and all console logs are saved to logs/build.log
                    mvn clean test -DtestFailureIgnore=true | tee logs/build.log
                '''
            }
        }
    }

    post {
        always {
            script {
                def logContent = readFile('logs/build.log')
                // Only trigger analysis if there were actual failures
                if (logContent.contains("FAILURE!") || logContent.contains("BUILD FAILURE")) {
                    echo "Test failure detected! Running Bug Analyzer..."
                    sh 'java -jar ci-tools/bug-analyzer.jar --log logs/build.log --output reports'
                }
            }

            // Publish the HTML RCA Dashboard directly into Jenkins UI
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports',
                reportFiles: 'latest-analysis.html',
                reportName: 'Bug Analyzer RCA Report'
            ])
            
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
    }
}