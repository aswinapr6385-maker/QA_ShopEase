pipeline {
    agent any

    // Permanent path to the Bug Analyzer JAR (not in git — too large)
    environment {
        BUG_ANALYZER_JAR = '/Users/apple-harsh/tools/bug-analyzer.jar'
    }

    stages {
        stage('Run Tests') {
            steps {
                sh '''
                    mkdir -p logs reports
                    mvn clean test -DtestFailureIgnore=true | tee logs/build.log || true
                '''
            }
        }

        stage('Bug Analysis') {
            steps {
                sh '''
                    # Prefer TestNG XML (richer data). Fall back to build.log if XML missing.
                    if [ -f target/surefire-reports/testng-results.xml ]; then
                        echo "Running Bug Analyzer on TestNG XML..."
                        java -jar "$BUG_ANALYZER_JAR" \
                            --log target/surefire-reports/testng-results.xml \
                            --output reports
                    elif [ -f logs/build.log ]; then
                        echo "Running Bug Analyzer on build.log..."
                        java -jar "$BUG_ANALYZER_JAR" \
                            --log logs/build.log \
                            --output reports
                    else
                        echo "No log file found for Bug Analyzer. Skipping."
                    fi
                '''
            }
        }
    }

    post {
        always {
            // Publish Bug Analyzer RCA Report
            publishHTML(target: [
                allowMissing         : true,
                alwaysLinkToLastBuild: true,
                keepAll              : true,
                reportDir            : 'reports',
                reportFiles          : 'latest-analysis.html',
                reportName           : 'Bug Analyzer RCA Report'
            ])

            // Publish TestNG Execution Report
            publishHTML(target: [
                allowMissing         : true,
                alwaysLinkToLastBuild: true,
                keepAll              : true,
                reportDir            : 'test-output',
                reportFiles          : 'TestExecutionReport.html',
                reportName           : 'Test Execution Report'
            ])

            // Archive reports
            archiveArtifacts artifacts: 'reports/**, logs/**, test-output/*.html',
                             allowEmptyArchive: true

            // TestNG results — allow failures without marking UNSTABLE
            // failedTestsFailBuild: false keeps build as SUCCESS even if tests fail
            testNG results: '**/testng-results.xml',
                   unstableOnSkippedTests: false,
                   failedTestsFailBuild  : false
        }
    }
}